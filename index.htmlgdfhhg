<!doctype html>
<html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Central Residencial ESP32 | Acesso remoto</title>
<style>
:root{font-family:system-ui,Arial,sans-serif;color-scheme:dark;background:#101828;color:#edf4ff}*{box-sizing:border-box}body{max-width:1060px;margin:auto;padding:18px}h1{font-size:1.55rem}h2{font-size:1.12rem}h3{font-size:1rem}p,.muted{color:#a9bbd0}label{display:block;margin:9px 0;font-size:.88rem}input,select,button{font:inherit;max-width:100%;padding:10px;border-radius:9px}input,select{background:#10233a;color:#fff;border:1px solid #4a6482}input[type=number]{width:100%}input[type=checkbox]{accent-color:#50a3fa}button{cursor:pointer;background:#2a7db7;color:white;border:0;font-weight:bold}button:disabled{opacity:.5}.card,fieldset{background:#1a2940;border:1px solid #344b69;border-radius:13px;padding:14px}.panel{margin:15px 0}.grid,.two{display:grid;grid-template-columns:repeat(auto-fit,minmax(195px,1fr));gap:12px}header,.row{display:flex;align-items:center;gap:10px;flex-wrap:wrap}header{justify-content:space-between}.metric{font-size:1.4rem;display:block;margin-top:7px}.tag{font-size:.85rem;background:#344962;padding:7px 10px;border-radius:9px}.tabs{display:flex;gap:8px;flex-wrap:wrap;margin:17px 0}.tabs button{background:#243b54}.tabs button.active{background:#2b7bb9}.tab[hidden],#app[hidden],#login[hidden]{display:none!important}canvas{display:block;background:#0b182a;border-radius:8px;width:100%;height:190px}.note{border-left:3px solid #e4a34c;background:#30291e;padding:12px}.hint{font-size:.82rem}.checkbox{display:flex;align-items:center;gap:7px}#message,#loginMsg{padding:9px 0;min-height:25px}small{color:#bed0e1}
</style></head><body>
<header><div><h1>Central Residencial ESP32</h1><p>Monitoramento particular | Acesso remoto protegido</p></div><button id="logout" hidden>Sair</button></header>
<section id="login" class="card panel"><h2>Entrar no painel</h2><p>Seu usuário pessoal do Firebase, não a conta cadastrada no ESP32.</p><form id="loginForm"><label>E-mail <input id="email" type="email" required autocomplete="username"></label><label>Senha <input id="password" type="password" required autocomplete="current-password"></label><button type="submit">Entrar</button><div id="loginMsg"></div></form></section>
<section id="app" hidden><div class="row"><span id="connection" class="tag">Aguardando dados...</span><span id="updated" class="tag">Última atualização: --</span></div>
<nav class="tabs"><button class="active" data-tab="overview">Visão geral</button><button data-tab="history">Histórico</button><button data-tab="settings">Configurações</button></nav>
<section class="tab" id="tab-overview"><div class="grid">
<div class="card">DHT11 1<strong class="metric" id="t1">--</strong><small id="h1">Umidade: --</small></div>
<div class="card">DHT11 2<strong class="metric" id="t2">--</strong><small id="h2">Umidade: --</small></div>
<div class="card">BMP180<strong class="metric" id="pressure">--</strong><small id="bmpTemp">Temperatura: --</small></div>
<div class="card">Presença<strong class="metric" id="pir">--</strong><small>Sensor PIR</small></div>
<div class="card">Chuva<strong class="metric" id="rain">--</strong><small>Módulo resistivo</small></div>
<div class="card">Buzzer<strong class="metric" id="playing">--</strong><small>Alarme em execução</small></div>
<div class="card">Distância 1<strong class="metric" id="dist1">--</strong><small>HC-SR04</small></div>
<div class="card">Distância 2<strong class="metric" id="dist2">--</strong><small>HC-SR04</small></div>
<div class="card">Distância 3<strong class="metric" id="dist3">--</strong><small>HC-SR04</small></div>
</div><p class="note">Relés Wi-Fi: <strong id="relay">sem comando</strong>. Até confirmar marca e modelo, somente a solicitação lógica é exibida, sem ligar/desligar dispositivos.</p></section>
<section class="tab" id="tab-history" hidden><div class="card"><h2>Gráficos na nuvem</h2><div class="row"><label>Período <select id="range"><option value="day">Hoje</option><option value="24h">Últimas 24 horas</option><option value="week">Últimos 7 dias</option><option value="all">Tudo carregado</option></select></label><button id="loadHistory">Consultar</button><button id="csv">Exportar CSV</button></div><p class="hint" id="historyInfo">O histórico é carregado apenas ao abrir esta aba.</p><div class="two"><div><h3>Temperatura (°C)</h3><canvas id="chartT" width="640" height="230"></canvas></div><div><h3>Umidade (%)</h3><canvas id="chartH" width="640" height="230"></canvas></div><div><h3>Pressão local (hPa)</h3><canvas id="chartP" width="640" height="230"></canvas></div></div><p class="hint">Até 2.200 registros recentes por consulta. A retenção total depende da cota gratuita da nuvem.</p></div></section>
<section class="tab" id="tab-settings" hidden><form id="settingsForm" class="card"><h2>Configurações remotas</h2><p class="hint">Alterações são salvas na nuvem. O ESP32 verifica as configurações aproximadamente a cada 20 segundos enquanto conectado à internet.</p><div class="two"><fieldset><legend>Temperatura e coleta</legend>
<label>Sensor para alertas <select name="sensor"><option value="1">DHT11 1</option><option value="2">DHT11 2</option></select></label>
<label>Temperatura alta (°C) <input name="hot" type="number" step=".1" min="-10" max="70"></label><label>Temperatura baixa (°C) <input name="cold" type="number" step=".1" min="-10" max="70"></label><label>Histerese (°C) <input name="hyst" type="number" step=".1" min=".2" max="5"></label>
<label>Leitura a cada (segundos) <input name="sample" type="number" min="2" max="300"></label><label>Registro histórico (segundos) <input name="log" type="number" min="60" max="3600"></label><label class="checkbox"><input name="buzzer" type="checkbox"> Habilitar buzzer</label>
</fieldset><fieldset><legend>Pressão</legend><label class="checkbox"><input name="pAbsEnabled" type="checkbox"> Alarme de pressão absoluta</label><label>Pressão alta (hPa) <input name="pHigh" type="number" step=".1" min="700" max="1100"></label><label>Pressão baixa (hPa) <input name="pLow" type="number" step=".1" min="700" max="1100"></label><label class="checkbox"><input name="pDeltaEnabled" type="checkbox"> Alarme por variação</label><label>Diferença de pressão (hPa) <input name="pDelta" type="number" step=".1" min=".5" max="30"></label><label>Janela (minutos) <input name="pWindow" type="number" min="5" max="240"></label><label>Direção <select name="pDirection"><option value="0">Ambas</option><option value="1">Queda</option><option value="2">Aumento</option></select></label></fieldset></div>
<h3>Ultrassônicos</h3><p class="hint">Só habilite após instalar os divisores de tensão nos três sinais ECHO.</p><div class="row"><label class="checkbox"><input name="us0" type="checkbox"> HC-SR04 1</label><label class="checkbox"><input name="us1" type="checkbox"> HC-SR04 2</label><label class="checkbox"><input name="us2" type="checkbox"> HC-SR04 3</label></div>
<h3>Alarmes sonoros individuais</h3><div id="alarmForms" class="two"></div><p><button type="submit">Salvar configurações</button></p><div id="message"></div></form></section>
</section>
<script type="module">
// Substitua pela configuracao WEB do seu proprio projeto Firebase.
// Estes identificadores PUBLICOS podem ficar no HTML. NUNCA coloque senhas aqui.
const firebaseConfig = {
  apiKey: "AIzaSyBxmcbtsCnrGtFpOeM4P82vhYPaPD4jVjg",
  authDomain: "central-residencial-esp32.firebaseapp.com",
  databaseURL: "https://central-residencial-esp32-default-rtdb.firebaseio.com",
  projectId: "central-residencial-esp32",
  appId: "1:630483386333:web:6f0ccb3a1f963987678034"
};
import { initializeApp } from 'https://www.gstatic.com/firebasejs/11.10.0/firebase-app.js';
import { getAuth,onAuthStateChanged,signInWithEmailAndPassword,signOut } from 'https://www.gstatic.com/firebasejs/11.10.0/firebase-auth.js';
import { getDatabase,ref,onValue,get,set,query,limitToLast } from 'https://www.gstatic.com/firebasejs/11.10.0/firebase-database.js';
const $=x=>document.getElementById(x), form=document.querySelector('#settingsForm');
const app=initializeApp(firebaseConfig),auth=getAuth(app),db=getDatabase(app);
const names=['Calor','Frio','Chuva','Movimento','Pressão alta','Pressão baixa','Pressão subindo','Pressão caindo'];
const baseAlarms=[{enabled:true,hz:2250,bps:3,on:110,dur:4,rep:120},{enabled:true,hz:750,bps:1,on:350,dur:4,rep:120},{enabled:true,hz:1450,bps:2,on:140,dur:4,rep:90},{enabled:true,hz:1100,bps:4,on:70,dur:2,rep:15},{enabled:true,hz:2000,bps:2,on:150,dur:5,rep:300},{enabled:true,hz:900,bps:1.3,on:270,dur:5,rep:300},{enabled:true,hz:1750,bps:2.5,on:120,dur:5,rep:300},{enabled:true,hz:550,bps:1,on:450,dur:5,rep:300}];
const defaults={sample:3,log:300,sensor:1,hot:32,cold:15,hyst:1,buzzer:true,pAbsEnabled:false,pDeltaEnabled:false,pHigh:1030,pLow:900,pDelta:3,pWindow:60,pDirection:0,ultrasonic:[false,false,false],alarms:baseAlarms};
$('alarmForms').innerHTML=names.map((n,i)=>`<fieldset><legend>${n}</legend><label class="checkbox"><input name="e${i}" type="checkbox"> Ativo</label><label>Tom (Hz)<input name="hz${i}" type="number" min="200" max="5000"></label><label>Bipes/s<input name="bps${i}" type="number" min="0.2" max="10" step=".1"></label><label>Tempo do bip (ms)<input name="on${i}" type="number" min="20" max="2000"></label><label>Duração total (s)<input name="dur${i}" type="number" min="1" max="60"></label><label>Repetir em (s)<input name="rep${i}" type="number" min="3" max="3600"></label></fieldset>`).join('');
const f=x=>form.elements.namedItem(x), nf=(n,u='')=>n==null||!Number.isFinite(Number(n))?'Sem leitura':Number(n).toFixed(1).replace('.',',')+u;
function fill(d){const c={...defaults,...(d||{})};for(const k of ['sample','log','sensor','hot','cold','hyst','pHigh','pLow','pDelta','pWindow','pDirection'])f(k).value=c[k];for(const k of ['buzzer','pAbsEnabled','pDeltaEnabled'])f(k).checked=!!c[k];for(let i=0;i<3;i++)f('us'+i).checked=!!c.ultrasonic?.[i];for(let i=0;i<8;i++){const a=c.alarms?.[i]||baseAlarms[i];for(const k of ['hz','bps','on','dur','rep'])f(k+i).value=a[k];f('e'+i).checked=!!a.enabled;}}
function read(){const v=x=>Number(f(x).value),b=x=>f(x).checked;const c={sample:v('sample'),log:v('log'),sensor:v('sensor'),hot:v('hot'),cold:v('cold'),hyst:v('hyst'),buzzer:b('buzzer'),pAbsEnabled:b('pAbsEnabled'),pDeltaEnabled:b('pDeltaEnabled'),pHigh:v('pHigh'),pLow:v('pLow'),pDelta:v('pDelta'),pWindow:v('pWindow'),pDirection:v('pDirection'),ultrasonic:[0,1,2].map(i=>b('us'+i)),alarms:baseAlarms.map((_,i)=>({enabled:b('e'+i),hz:v('hz'+i),bps:v('bps'+i),on:v('on'+i),dur:v('dur'+i),rep:v('rep'+i)}))};if(c.cold+c.hyst>=c.hot)throw Error('Temperatura baixa + histerese deve ser menor que temperatura alta.');if(c.pLow>=c.pHigh)throw Error('Pressão baixa deve ser menor que pressão alta.');return c;}
$('loginForm').addEventListener('submit',async e=>{e.preventDefault();$('loginMsg').textContent='Autenticando...';try{await signInWithEmailAndPassword(auth,$('email').value,$('password').value);$('password').value='';$('loginMsg').textContent='';}catch(err){$('loginMsg').textContent='Não foi possível entrar. Confira a conta, a senha e a configuração do Firebase.';}});
$('logout').onclick=()=>signOut(auth);
let unsubStatus=null,unsubCfg=null,historyRows=[];
onAuthStateChanged(auth,user=>{if(unsubStatus){unsubStatus();unsubStatus=null;}if(unsubCfg){unsubCfg();unsubCfg=null;}$('login').hidden=!!user;$('app').hidden=!user;$('logout').hidden=!user;if(!user)return;
 unsubStatus=onValue(ref(db,'home/status'),snap=>{const d=snap.val();if(!d){$('connection').textContent='ESP32 ainda não enviou dados';return;}const ts=Date.parse((d.time||'').replace(' ','T')+'-03:00');let stale=!Number.isFinite(ts)||Date.now()-ts>120000;$('connection').textContent=stale?'Última leitura antiga':'Dados recebidos';$('updated').textContent='Registro: '+(d.time||'--');
 for(const k of ['t1','t2'])$(k).textContent=nf(d[k],' °C');for(const k of ['h1','h2'])$(k).textContent='Umidade: '+nf(d[k],' %');$('pressure').textContent=nf(d.pressure,' hPa');$('bmpTemp').textContent='Temperatura: '+nf(d.bmpTemp,' °C');$('pir').textContent=d.pir?'Movimento':'Sem movimento';$('rain').textContent=d.rain?'Molhado':'Seco';$('playing').textContent=d.playing||'Silencioso';for(let i=0;i<3;i++)$('dist'+(i+1)).textContent=d.ultrasonic?.[i]?nf(d.distances?.[i],' cm'):'Desativado';$('relay').textContent=`Quente: ${d.hotWanted?'solicitar ligar':'desligado'} / Frio: ${d.coldWanted?'solicitar ligar':'desligado'}. Sem comando real.`;
 },()=>{$('connection').textContent='Sem permissão para ler. Confira as regras do banco.';});
 unsubCfg=onValue(ref(db,'home/config'),snap=>fill(snap.val()),()=>{$('message').textContent='Sem permissão para ler configuração.';});
});
form.addEventListener('submit',async e=>{e.preventDefault();try{const c=read();await set(ref(db,'home/config'),c);$('message').textContent='Configurações enviadas. Aguarde até 20 s para o ESP32 aplicar.';}catch(err){$('message').textContent='Falha ao salvar: '+err.message;}});
function chart(id,rows,keys,colors){const c=$(id),ctx=c.getContext('2d'),w=c.width,h=c.height;ctx.clearRect(0,0,w,h);ctx.font='14px system-ui';const vals=rows.flatMap(x=>keys.map(k=>x[k])).filter(x=>typeof x==='number'&&Number.isFinite(x));if(!vals.length){ctx.fillStyle='#b8cadc';ctx.fillText('Sem dados neste período',20,38);return;}let lo=Math.min(...vals),hi=Math.max(...vals),pad=Math.max(.3,(hi-lo)*.12);lo-=pad;hi+=pad;const L=55,R=w-12,T=17,B=h-32;for(let i=0;i<5;i++){const y=T+(B-T)*i/4;ctx.strokeStyle='#2d4763';ctx.beginPath();ctx.moveTo(L,y);ctx.lineTo(R,y);ctx.stroke();ctx.fillStyle='#b8cadc';ctx.fillText((hi-(hi-lo)*i/4).toFixed(1),5,y+4);}keys.forEach((k,j)=>{ctx.strokeStyle=colors[j];ctx.lineWidth=2.5;ctx.beginPath();let start=false;rows.forEach((r,i)=>{const v=r[k];if(!Number.isFinite(v)){start=false;return;}const x=L+(R-L)*i/Math.max(1,rows.length-1),y=T+(B-T)*(hi-v)/(hi-lo);if(!start){ctx.moveTo(x,y);start=true}else ctx.lineTo(x,y)});ctx.stroke();ctx.fillStyle=colors[j];ctx.fillText(k,L+j*95,h-7);});}
function filtered(){const now=new Date(),mode=$('range').value;let rows=historyRows.filter(r=>{const t=r.epoch*1000;if(mode==='all')return true;if(mode==='24h')return t>=Date.now()-86400000;if(mode==='week')return t>=Date.now()-7*86400000;return new Date(t).toDateString()===now.toDateString();});if(rows.length>500){const step=(rows.length-1)/499;rows=Array.from({length:500},(_,i)=>rows[Math.round(i*step)]);}return rows;}
function renderHistory(){const rows=filtered();$('historyInfo').textContent=`${rows.length} pontos exibidos de ${historyRows.length} carregados.`;chart('chartT',rows,['t1','t2','bmpTemp'],['#63c9fb','#ffc481','#c39bff']);chart('chartH',rows,['h1','h2'],['#63c9fb','#ffc481']);chart('chartP',rows,['pressure'],['#99efc6']);}
async function loadHistory(){if(!auth.currentUser)return;$('historyInfo').textContent='Carregando...';try{const snap=await get(query(ref(db,'home/history'),limitToLast(2200)));const data=snap.val()||{};historyRows=Object.entries(data).map(([key,d])=>({...d,epoch:Number(key)})).filter(d=>Number.isFinite(d.epoch)).sort((a,b)=>a.epoch-b.epoch);renderHistory();}catch(err){$('historyInfo').textContent='Falha ao consultar histórico. Confira permissões e internet.';}}
$('loadHistory').onclick=loadHistory;$('range').onchange=renderHistory;
$('csv').onclick=()=>{if(!historyRows.length)return;const cols=['epoch','time','t1','h1','t2','h2','bmpTemp','pressure','pir','rain'];const csv=[cols.join(','),...historyRows.map(r=>cols.map(k=>r[k]??'').join(','))].join('\n');const u=URL.createObjectURL(new Blob([csv],{type:'text/csv;charset=utf-8'}));const a=document.createElement('a');a.href=u;a.download='esp32_historico_cloud.csv';a.click();URL.revokeObjectURL(u);};
document.querySelectorAll('.tabs button').forEach(b=>b.onclick=()=>{document.querySelectorAll('.tabs button').forEach(x=>x.classList.toggle('active',x===b));document.querySelectorAll('.tab').forEach(x=>x.hidden=(x.id!=='tab-'+b.dataset.tab));if(b.dataset.tab==='history'&&!historyRows.length)loadHistory();});
fill(defaults);
</script></body></html>
